# Sao chep thanh .env roi doi gia tri. Docker Compose tu doc .env.

# Kong noi ra may Windows cua load balancer
LB_HTTP_PORT=8080
LB_HTTPS_PORT=8443

# Mat khau trong lab. Trong he thong that khong duoc phep ghi mat khau vao file nay
# ma phai dung secret cua Docker Swarm hoac vault.
DB_ROOT_PASSWORD=RootPass0
DB_PASSWORD=WebAppPass0
REDIS_PASSWORD=RedisPass0

# Tham so dinh kem cua nginx
LB_ALGO_DIRECTIVE=least_conn;
MAX_FAILS=2
FAIL_TIMEOUT=10s

# Che do luu session: redis (dung) hoac file (de doi chung)
SESSION_STORE=redis
