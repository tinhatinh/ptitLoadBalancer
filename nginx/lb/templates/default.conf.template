upstream web_cluster {
    ${LB_ALGO_DIRECTIVE}

    server web01:${BACKEND_PORT} max_fails=${MAX_FAILS} fail_timeout=${FAIL_TIMEOUT};
    server web02:${BACKEND_PORT} max_fails=${MAX_FAILS} fail_timeout=${FAIL_TIMEOUT};
    server web03:${BACKEND_PORT} max_fails=${MAX_FAILS} fail_timeout=${FAIL_TIMEOUT};

    keepalive 32;
}

# --- HTTP: chi dung de chuyen huong sang HTTPS, tru /healthz ---
#
# Trinh duyet goi http://localhost:8080 ma 301 tro thang toi https://$host thi
# tro thanh https://localhost/ (cong 443), noi khong co ai nghe: Docker cong bo
# HTTPS o 8443. Hai gia tri Host duoc phep doi cong la gia tri co dinh, khong
# phai chuoi Host khach hang gui den, neu khong se mo ra tan cong chuyen huong
# qua header Host.
map $http_host $lb_https_target {
    hostnames;
    default                          https://$host;
    "~^localhost:${LB_HTTP_PORT}$"   https://localhost:${LB_HTTPS_PORT};
    "~^127\\.0\\.0\\.1:${LB_HTTP_PORT}$"  https://127.0.0.1:${LB_HTTPS_PORT};
}

server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
        proxy_pass http://web_cluster/healthz.php;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log /var/log/nginx/healthz.log lb_trace;
    }

    location / {
        return 301 $lb_https_target$request_uri;
    }
}

# --- HTTPS: toan bo luu luong ung dung đi qua day ---
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cluster.crt;
    ssl_certificate_key /etc/nginx/certs/cluster.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    # Chung chi la RSA nen cac bo ECDHE-ECDSA o day khong bao gio duoc chon;
    # giu lai chi gay nhieu hieu lam "da chan het mat ma yeu". rieng TLS 1.3
    # khong doc danh sach nay, no dung ssl_ciphersuites mac dinh cua nginx.
    ssl_ciphers         ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    # voi session ticket, khach hang phuc hoi phien ma khong qua bat ky lan
    # bat tay nao, va khoa sinh ticket cua nginx khong tu dao vong. Tat di de
    # kiem tra an toan khong bao "phuc hoi phien duoc" trong khi thuc te la
    # mot co che khong the thu hoi.
    ssl_session_tickets off;

    # An danh tinh ban cua may chu nguon. Nginx tu thay header Server cua
    # upstream bang header cua no, va server_tokens off o nginx.conf cat di
    # phien ban. X-Node du giu lai co y dinh: do la dung cu do cua de tai.
    proxy_hide_header  Server;
    proxy_hide_header  X-Powered-By;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff"                              always;
    add_header X-Frame-Options           "SAMEORIGIN"                           always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"      always;
    add_header Content-Security-Policy   "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'" always;

    proxy_connect_timeout 2s;
    proxy_send_timeout    10s;
    proxy_read_timeout    10s;
    proxy_next_upstream   error timeout http_500 http_502 http_503 http_504;
    proxy_next_upstream_tries 2;
    proxy_next_upstream_timeout 10s;

    # Chan trai cua rieng bo can bang tai: nginx tra loi ngay, khong mo ket
    # noi toi node. Do voi /healthz va /index.php se tach duoc chi phi cua
    # tung tang: can bang tai, tang web, tang ung dung va co so du lieu.
    location = /lb-only {
        return 200 "lb\n";
    }

    location = /healthz {
        proxy_pass http://web_cluster/healthz.php;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log /var/log/nginx/healthz.log lb_trace;
    }

    # Loi dung kiem chung che do gioi han tan suat. Phai proxy_pass chu khong
    # duoc dung return: return chay o giai doan rewrite, som hon limit_req
    # o giai doan preaccess, nen location chi co return se khong bao gio bi chan.
    location = /ratelimit-probe {
        limit_req zone=probe burst=5 nodelay;
        proxy_pass http://web_cluster/healthz.php;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log /var/log/nginx/probe.log lb_trace;
    }

    location ~ ^/(login|logout)\.php$ {
        limit_req zone=auth burst=5;
        limit_conn perip 20;
        proxy_pass http://web_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web_cluster;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
